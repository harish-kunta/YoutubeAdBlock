{
  "manifest_version": 3,
  "name": "YouTube Ad & Shorts Controls",
  "version": "1.0.5",
  "description": "Unofficial controls for hiding common YouTube ad placements and Shorts. Coverage and playback compatibility can vary.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube Ad & Shorts Controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["player-filter.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
